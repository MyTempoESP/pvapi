@startuml
start

:Cliente gera **session_id** (temp_xxxxx);

partition "Gestão do Carrinho — /carrinho" {
  note right
    Todos os endpoints do carrinho
    exigem **?session_id=**
  end note

  :POST /carrinho/adicionar;
  note right
    **Requisição**
    {
      "product_id": 1,
      "quantity": 2,
      "personalization": {},
      "session_id": "temp_69af0..."
    }
  end note

  if (Carrinho ativo existe?) then (sim)
    :Reusar cart_id;
  else (não)
    :Criar novo carrinho\n(INSERT INTO carts);
  endif

  :INSERT INTO cart_product\n(product_id, quantity, personalization, cart_id);

  note right
    **Resposta (200)**
    { "success": true,
      "message": "produto adicionado!" }
  end note

  fork
    :GET /carrinho/dados;
    note right
      **Resposta**
      { "items": [...],
        "total": 0,
        "item_count": N,
        "total_with_discount": 0,
        "total_discount": 0,
        "session_id": "..." }
    end note

  fork again
    :GET /carrinho/remessas;
    note right
      **Resposta**
      { "products": [{
          "product_id": 1,
          "consignments": [{
            "consignment_id": 1,
            "price_in_consignment": "600",
            "consignment_stock": 4,
            "pickup": { "id", "name", "date", "address" }
          }]
        }]
      }
    end note

  fork again
    :PUT /carrinho/atualizar/:item;
    note right
      **Requisição** { "quantity": 5 }
      **Resposta** { "success": true }
      Exige session_id na query
    end note

  fork again
    :DELETE /carrinho/remover/:item;
    note right
      **Resposta** { "success": true }
      Exige session_id na query
    end note
  end fork

  if (Carrinho vazio após remoção?) then (sim)
    :Carrinho sem itens;
    note left: Checkout subsequente\nfalhará com 422
  else (não)
    :Carrinho pronto para checkout;
  endif
}

partition "Confirmação do Checkout — /checkouts" {
  :POST /checkouts/confirm?session_id=...;

  if (session_id presente?) then (sim)
  else (não)
    :Abortar: "session_id is required"; <<#pink>>
    detach
  endif

  note right
    **Corpo da requisição**
    {
      "value_paid": "1200",
      "external_reference": "PAY-12345",
      "items": [{
        "product_id": 1,
        "consignment_id": 1,
        "quantity": 2
      }]
    }
  end note

  if (Corpo da requisição válido?) then (sim)
  else (não)
    :Abortar: erros de validação; <<#pink>>
    detach
  endif

  :BEGIN TRANSACTION;

  if (Idempotência: checkout existe\npara session_id +\nexternal_reference?) then (sim)
    :Retornar unique_id existente; <<#palegreen>>

    note left
      **Resposta (200)**
      { "success": true,
        "unique_id": "mesmo-uuid",
        "status": "paid" }
    end note

    :COMMIT;
    detach
  else (não)
  endif

  :Resolver cart_id de carts\nWHERE session_id = $1\nAND session_id NOT LIKE 'FINISHED-%';

  if (Carrinho encontrado?) then (sim)
    if (Carrinho tem itens?) then (sim)
      :Para cada item na requisição:

      :Consultar estoque em package_reserved\npor (product_id, consignment_id); <<#lightblue>>
      :Verificar disponível ≥ quantidade; <<#lightblue>>

      if (Estoque suficiente para todos?) then (sim)
        :Parsear value_paid → decimal;
        :INSERT INTO checkouts\n→ unique_id (UUID);

        :BATCH INSERT em package_reserved\n(product_id, checkout_id, quantity);

        :Finalizar carrinho:\nUPDATE carts SET session_id =\n'FINISHED-{external_reference}';

        :COMMIT; <<#palegreen>>

        note left
          **Resposta (200)**
          { "success": true,
            "message": "checkout confirmed",
            "unique_id": "550e8400-...",
            "status": "paid" }
        end note

      else (não)
        :ROLLBACK;\nEstoque insuficiente (409); <<#pink>>
        detach
      endif
    else (não)
      :ROLLBACK;\nCarrinho vazio (422); <<#pink>>
      detach
    endif
  else (não)
    :ROLLBACK;\nCarrinho não encontrado (404); <<#pink>>
    detach
  endif
}

partition "Pós-Checkout" {
  :Session_id do carrinho renomeado\npara FINISHED-{external_reference};

  if (Cliente consulta /carrinho/dados\ncom session_id antigo?) then (sim)
    :Retorna 404 "resource not found";
  endif

  if (Cliente reenvia mesmo checkout?) then (sim)
    :Idempotência retorna mesmo unique_id;
  endif
}

stop
@enduml
