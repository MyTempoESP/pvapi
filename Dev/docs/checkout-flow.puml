@startuml
start

:Client generates **session_id** (temp_xxxxx);

partition "Cart Management — /carrinho" {
  note right
    All cart endpoints require
    **?session_id=** query parameter
  end note

  :POST /carrinho/adicionar;
  note right
    **Request**
    {
      "product_id": 1,
      "quantity": 2,
      "personalization": {},
      "session_id": "temp_69af0..."
    }
  end note

  if (Active cart exists?) then (yes)
    :Reuse cart_id;
  else (no)
    :Create new cart\n(INSERT INTO carts);
  endif

  :INSERT INTO cart_product\n(product_id, quantity, personalization, cart_id);

  note right
    **Response (200)**
    { "success": true,
      "message": "produto adicionado!" }
  end note

  fork
    :GET /carrinho/dados;
    note right
      **Response**
      { "items": [...],
        "total": 0,
        "item_count": N,
        "total_with_discount": 0,
        "total_discount": 0,
        "session_id": "..." }
    end note

  fork again
    :GET /carrinho/remessas;
    note right
      **Response**
      { "products": [{
          "product_id": 1,
          "consignments": [{
            "consignment_id": 1,
            "price_in_consignment": "600",
            "consignment_stock": 4,
            "pickup": { "id", "name", "date", "address" }
          }]
        }]
      }
    end note

  fork again
    :PUT /carrinho/atualizar/:item;
    note right
      **Request** { "quantity": 5 }
      **Response** { "success": true }
      Requires session_id in query
    end note

  fork again
    :DELETE /carrinho/remover/:item;
    note right
      **Response** { "success": true }
      Requires session_id in query
    end note
  end fork

  if (Cart empty after removal?) then (yes)
    :Cart has no items;
    note left: Further checkout will\nfail with 422
  else (no)
    :Cart ready for checkout;
  endif
}

partition "Checkout Confirmation — /checkouts" {
  :POST /checkouts/confirm?session_id=...;

  if (session_id present?) then (yes)
  else (no)
    #pink:Abort: "session_id is required";
    detach
  endif

  note right
    **Request body**
    {
      "value_paid": "1200",
      "external_reference": "PAY-12345",
      "items": [{
        "product_id": 1,
        "consignment_id": 1,
        "quantity": 2
      }]
    }
  end note

  if (Request body valid?) then (yes)
  else (no)
    #pink:Abort: field validation errors;
    detach
  endif

  :BEGIN TRANSACTION;

  if (Idempotency: checkout exists\nfor session_id +\nexternal_reference?) then (yes)
    #palegreen:Return existing unique_id;

    note left
      **Response (200)**
      { "success": true,
        "unique_id": "same-uuid",
        "status": "paid" }
    end note

    :COMMIT;
    detach
  else (no)
  endif

  :Resolve cart_id from carts\nWHERE session_id = $1\nAND session_id NOT LIKE 'FINISHED-%';

  if (Cart found?) then (yes)
    if (Cart has items?) then (yes)
      :For each item in request:

      #lightblue:Query package_reserved stock\nper (product_id, consignment_id);
      #lightblue:Check available ≥ quantity;

      if (Stock sufficient for all?) then (yes)
        :Parse value_paid → decimal;
        :INSERT INTO checkouts\n→ unique_id (UUID);

        :BATCH INSERT into package_reserved\n(product_id, checkout_id, quantity);

        :Finish cart:\nUPDATE carts SET session_id =\n'FINISHED-{external_reference}';

        #palegreen:COMMIT;

        note left
          **Response (200)**
          { "success": true,
            "message": "checkout confirmed",
            "unique_id": "550e8400-...",
            "status": "paid" }
        end note

      else (no)
        #pink:ROLLBACK;\nInsufficient stock (409);
        detach
      endif
    else (no)
      #pink:ROLLBACK;\nCart empty (422);
      detach
    endif
  else (no)
    #pink:ROLLBACK;\nCart not found (404);
    detach
  endif
}

partition "Post-Checkout" {
  :Cart session_id renamed to\nFINISHED-{external_reference};

  if (Client queries /carrinho/dados\nwith old session_id?) then (yes)
    :Returns 404 "resource not found";
  endif

  if (Client resubmits same checkout?) then (yes)
    :Idempotency returns same unique_id;
  endif
}

stop
@enduml
