@startuml
hide circle
skinparam linetype ortho

entity "**addresses**" {
  + ""id"": //serial [PK]//
  --
  *""street"": //text //
  *""city"": //text //
  *""neighborhood"": //text //
  *""state"": //text //
  *""cep"": //text //
  *""number"": //integer //
  ""complement"": //text //
}

entity "**admins**" {
  + ""id"": //serial [PK]//
  --
  *""user_id"": //integer [FK]//
}

entity "**cart_product**" {
  + ""id"": //serial [PK]//
  --
  *""product_id"": //integer [FK]//
  *""cart_id"": //integer [FK]//
  *""personalizations"": //jsonb //
  *""quantity"": //integer //
  *""price"": //numeric(12,2) //
}

entity "**carts**" {
  + ""id"": //serial [PK]//
  --
  ""client_id"": //integer [FK]//
