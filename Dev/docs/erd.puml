  *""user_id"": //integer [FK]//
  *""address_id"": //integer [FK]//
  *""telephone"": //text //
  *""slug"": //text //
  *""name"": //text //
  ""created_at"": //timestamp with time zone //
  ""status"": //text //
}

entity "**users**" {
  + ""id"": //serial [PK]//
  --
  *""name"": //text //
  *""email"": //text //
  *""password_hash"": //text //
}

