  ""created_at"": //timestamp with time zone //
  *""status"": //text //
  *""code"": //uuid //
  *""slug"": //text //
}

entity "**package_reserved**" {
  + ""id"": //serial [PK]//
  --
  *""package_id"": //integer [FK]//
  *""checkout_id"": //integer [FK]//
  *""quantity"": //integer //
  ""reserved_at"": //timestamp with time zone //
}

entity "**packages**" {
  + ""id"": //serial [PK]//
  --
  *""product_id"": //integer [FK]//
  *""consignment_id"": //integer [FK]//
  *""quantity"": //integer //
  ""price"": //numeric(12,2) //
  ""created_at"": //timestamp with time zone //
  *""discount"": //numeric(12,2) //
  *""featured"": //boolean //
  *""attributesvalues"": //json //
}

entity "**pickup_locations**" {
  + ""id"": //serial [PK]//
  --
  ""address_id"": //integer [FK]//
  *""shop_id"": //integer [FK]//
  *""name"": //text //
  *""pickup_at"": //timestamp with time zone //
}

entity "**products**" {
  + ""id"": //serial [PK]//
  --
  *""name"": //text //
  *""price"": //numeric(12,2) //
  *""discount"": //numeric(5,2) //
  *""stock"": //integer //
  *""featured"": //boolean //
  *""shop_id"": //integer [FK]//
  ""moderation_status"": //text //
  *""category_id"": //integer [FK]//
  *""description"": //text //
  *""attr"": //jsonb //
  *""code"": //text //
  *""uniqueid"": //uuid //
  *""platform_cut"": //numeric(12,2) //
