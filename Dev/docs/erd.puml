}

entity "**categories**" {
  + ""id"": //serial [PK]//
  --
  *""name"": //text //
  *""description"": //text //
  *""shop_id"": //integer [FK]//
}

entity "**checkouts**" {
  + ""id"": //serial [PK]//
  --
  *""cart_id"": //integer [FK]//
  ""consignment_id"": //integer //
  ""unique_id"": //uuid //
  *""value"": //numeric(12,2) //
  *""status"": //text //
