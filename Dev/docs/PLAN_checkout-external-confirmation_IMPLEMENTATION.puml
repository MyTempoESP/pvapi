@startuml
!theme mars
skinparam actorStyle awesome
skinparam shadowing true
skinparam SequenceGroupBackgroundColor #FAE5C7
skinparam SequenceGroupBodyBackgroundColor #FAE5C7

actor "External\nSystem" as ext
boundary "API\n(checkout.go)" as api
control "checkoutmodel\nConfirm()" as model
database "PostgreSQL" as db

== Payment Confirmation (POST /checkouts/confirm) ==

ext -> api: POST /checkouts/confirm\n{cart_id, value_paid,\nexternal_reference, items[]}
activate api
api -> api: bind & validate\nConfirmRequest

api -> model: Confirm(ctx, pool, req)
activate model

model -> db: BEGIN
activate db

group Idempotency Check
    model -> db: SELECT unique_id FROM checkouts\nWHERE cart_id = $1\nAND external_reference = $2
    alt already exists
        db --> model: existing unique_id
        model -> db: COMMIT
        deactivate db
        model --> api: {unique_id}
        deactivate model
        api --> ext: 200 {unique_id}
        deactivate api
    else not found
        db --> model: no rows
    end
end

group Validate Cart
    model -> db: SELECT id, session_id FROM carts\nWHERE id = $1\nAND session_id NOT LIKE 'FINISHED-%'
    alt cart not found or already finished
        db --> model: no rows
        model -> db: ROLLBACK
        deactivate db
        model --> api: error "cart not found or already checked out"
        deactivate model
        api --> ext: 404
        deactivate api
    end

    model -> db: SELECT COUNT(*) FROM cart_product\nWHERE cart_id = $1
    alt cart is empty
        db --> model: 0
        model -> db: ROLLBACK
        deactivate db
        model --> api: error "cart has no items"
        deactivate model
        api --> ext: 422
        deactivate api
    end
end

group Stock Availability Check
    loop for each item in req.items
        model -> db: SELECT pkg.id, pkg.quantity,\n  COALESCE(SUM(pr.quantity), 0) AS reserved,\n  pkg.quantity - COALESCE(SUM(pr.quantity), 0) AS available\nFROM packages pkg\nLEFT JOIN package_reserved pr\n  ON pr.package_id = pkg.id\nWHERE pkg.product_id = $1\n  AND pkg.consignment_id = $2\nFOR UPDATE OF pkg

        alt package not found
            db --> model: no rows
            model -> db: ROLLBACK
            deactivate db
            model --> api: error "product X not available\nin consignment Y"
            deactivate model
            api --> ext: 422
            deactivate api
        else insufficient stock
            db --> model: available < requested
            model -> db: ROLLBACK
            deactivate db
            model --> api: error "insufficient stock\nfor product X"
            deactivate model
            api --> ext: 409
            deactivate api
        else available
            db --> model: package_id, available
        end
    end
end

group Insert Checkout
    model -> db: INSERT INTO checkouts\n(cart_id, value, status,\nexternal_reference, description)\nVALUES ($1, $2, 'paid', $3, $4)\nRETURNING unique_id
    db --> model: unique_id (uuid)
end

group Reserve Stock
    loop for each item in req.items
        model -> db: INSERT INTO package_reserved\n(package_id, checkout_id, quantity)\nVALUES ($1, $2, $3)
    end
end

group Finish Cart (soft-delete)
    model -> db: UPDATE carts\nSET session_id = 'FINISHED-' || $2\nWHERE id = $1
    note right of db
        cart_session_unique constraint
        preserved. Original session_id
        is now free for a new cart.
    end note
end

model -> db: COMMIT
deactivate db

model --> api: {unique_id}
deactivate model

api --> ext: 200 {unique_id, status: "paid"}
deactivate api

@enduml
