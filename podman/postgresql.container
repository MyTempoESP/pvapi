[Unit]
Description=Postgres pvauto
After=network-online.target

[Container]
Image=docker.io/library/postgres:18
Pod=pvauto.pod
Environment="POSTGRES_USER=pvauto"
Environment="POSTGRES_DB=pvauto_db"
Environment="POSTGRES_PASSWORD=ajF0a&_jmKI19E#"
Volume=%h/pvauto/pgdata:/var/lib/postgresql:Z

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target default.target
