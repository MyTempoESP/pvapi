"**consignment_pickup_locations**"   }--  "**pickup_locations**"

"**consignments**"   }--  "**consignees**"

"**consignments**"   }--  "**shops**"

"**package_reserved**"   }--  "**checkouts**"

"**package_reserved**"   }--  "**clients**"

"**package_reserved**"   }--  "**packages**"

"**package_reserved**"   }--  "**pickup_locations**"

"**packages**"   }--  "**consignments**"

