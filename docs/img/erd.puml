"**pickup_locations**"   }--  "**shops**"

"**products**"   }--  "**categories**"

"**products**"   }--  "**shops**"

"**recovery_tokens**"   }--  "**users**"

"**reports**"   }--  "**consignments**"

"**reports**"   }--  "**products**"

"**saques**"   }--  "**shops**"

"**saques**"   }--  "**users**"

"**saques**"   }--  "**bank_accounts**"

"**shops**"   }--  "**addresses**"

"**shops**"   }--  "**users**"

"**shops**"   }--  "**users**"
@enduml
