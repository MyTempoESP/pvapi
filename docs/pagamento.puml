@startuml
!theme mars
autoactivate on
skinparam actorStyle awesome
skinparam shadowing true
skinparam SequenceGroupBackgroundColor #FAE5C7
skinparam SequenceGroupBodyBackgroundColor #FAE5C7
skinparam SequenceReferenceBackgroundColor #lightgray

!$i = 1
!procedure $query($from, $name)
$from -> db: //$name()// [**Query** //$i//]
db --> $from
!$i = $i + 1
!endprocedure

actor User as User
boundary "front" as front
control "api" as api
database "db" as db
entity "Mercado Pago" as mp
control "api (kerlo)" as kerlo

== Adicionar ao Carrinho ==
User   -> front: click: adicionar ao carrinho
front  -> api: /carrinho/adicionar/1
note right of api
	Nao remove produto
	do estoque nesta etapa
end note
$query(api, AddProductToCartQuery)
api   --> front: 
front --> User: toast

== Acessa carrinho + Checkout ==
User -> front: click: carrinho
front --> User: painel: carrinho

User -> front: click: ir para entrega
front --> User: painel: escolher tipo de entrega

group Caso [ escolha = entrega em casa ]
  front --> User: form: dados de entrega
  User -> front: preenche formulario
  front --> front: salva dados no localstorage
else escolha = ponto de retirada
  note over User, front: opcao de ponto de retirada nao implementada
end

newpage

== Gerar Pagamento ==
User -> front: click: gerar pix
note left of front
	inclui dados do localstorage
	obtidos no passo anterior
end note
front -> api: /api/payments/pix/cart

note right of api
	segura o estoque antes de
	criar o pagamento, isso evita
	uma janela em que o usuario
	perde o item
end note
$query(api, CartHoldStock)

group Interromper [ se indisponivel ]
  note right of api
  	caso de produto indisponivel,
  	retornando status 500
  end note
  api --> front: //HTTP 500//
  front --> User: erro
end

api -> mp: Cria //Order//
mp --> api: //QRCode//

$query(api, PaymentCreateQuery)

api --> front: //QRCode//
front --> User: painel: pagamento

== Confirmar pagamento ==

note right of db
	Os modulos devem ser idempotentes,
	ignorando o caso de pagamento ja
	confirmado.
end note

group Em Paralelo
	mp -> kerlo: //Webhook//
	note over front,api: //Em desenvolvimento//
	ref over kerlo, db: Confirm Payment
	kerlo --> mp
else
	front -> api: /payment/status/<order_id>
	api -> mp: Checa //Order//
	mp --> api: //payment//
	ref over api, db: Confirm Payment
	api --> front: //payment.status//
	front --> User: toast
end

@enduml

