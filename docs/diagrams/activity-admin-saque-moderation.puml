@startuml
' Admin saque approve/reject handler workflows
' POST /admin/moderacao/saques/:id/aprovar
' POST /admin/moderacao/saques/:id/rejeitar

start

if (Action?) then (aprovar)
  partition "AdminApproveHandler" {
    :Parse saque ID from URL param;
    :Find saque by ID;
    if (Found?) then (no)
      :404 Not Found;
      detach
    else (yes)
    endif

    :Open transaction;
    :Lock shop row (SELECT FOR UPDATE);
    :Compute AvailableBalance(shop);

    if (AvailableBalance >= 0?) then (no)
      :Rollback transaction;
      :400 Saldo insuficiente;
      detach
    else (yes)
    endif

    :UPDATE saques SET status='approved'\nWHERE id=$1 AND status='pending';

    if (Rows affected > 0?) then (no)
      :Rollback transaction;
      :400 Saque não está pendente;
      detach
    else (yes)
      :Commit transaction;
      :200 Saque aprovado com sucesso;
    endif
  }

else (rejeitar)
  partition "AdminRejectHandler" {
    :Parse saque ID from URL param;
    :Bind JSON body { "motivo": "..." };
    if (Valid?) then (no)
      :400 Bad Request;
      detach
    else (yes)
    endif

    :UPDATE saques\nSET status='rejected', motivo=$2\nWHERE id=$1 AND status='pending';

    if (Rows affected > 0?) then (no)
      :400 Saque não está pendente;
      detach
    else (yes)
      :200 Saque rejeitado com sucesso;
    endif
  }

endif

stop
@enduml
