@startuml
' ER diagram: data model for the consignee (monitor) feature
' Focus on the 3 tables updated by PUT /monitores/:consignee

skinparam linetype ortho

entity "users" as users {
  *id : serial <<generated>>
  --
  *name : text
  *email : text <<unique>>
  *password_hash : text
}

entity "addresses" as addresses {
  *id : serial <<generated>>
  --
  *street : text
  *city : text
  *neighborhood : text
  *state : text
  *cep : text
  *"number" : integer
  complement : text
}

entity "consignees" as consignees {
  *id : serial <<generated>>
  --
  *user_id : integer <<FK>>
  *address_id : integer <<FK>>
  *shop_id : integer <<FK>>
  *telephone : text <<unique>>
}

entity "shops" as shops {
  *id : serial <<generated>>
  --
  *user_id : integer <<FK>>
  *address_id : integer <<FK>>
  *telephone : text
  *slug : text
}

entity "consignees_info_full_view" as view {
  *consignee_id : integer
  *phone : text
  *consignee_shop_id : integer
  --
  *user_name : text
  *user_email : text
  *addrstreet : text
  *addrnumber : integer
  *addrneigh : text
  *addrcity : text
  *addrstate : text
  *addrcep : text
  *addrcomplement : text
}

' Relationships

users ||--o{ consignees : "has"
addresses ||--o{ consignees : "located at"
shops ||--o{ consignees : "owns"
users ||--o{ shops : "owns"
addresses ||--o{ shops : "located at"

' The view denormalizes the 3 tables
view ..> users : "reads from"
view ..> consignees : "reads from"
view ..> addresses : "reads from"

note top of view
  consignees_info_full_view
  is a LEFT JOIN across
  consignees, users, addresses.
  Used by the handler to
  return the full resource
  after update.
end note

note bottom of consignees
  PUT /monitores/:consignee
  updates all 3 tables
  atomically in a single
  pgx.BeginFunc transaction.
end note

note left of users
  name and email
  updated here
end note

note left of addresses
  street, number,
  neighborhood, city,
  state, cep, complement
  updated in-place
end note

@enduml
