@startuml
' Activity diagram: post-checkout client creation/association workflow with checkout_shop update (pvapi-gbho)

start

partition "CreateAndAssociate" {
  :Open transaction;
  :Call Create(name, email, hash);
}

partition "Create (Client Resolution)" {
  if (Email exists in users?) then (yes)
    :Lookup user;
    if (User is client?) then (yes)
      :Return existing clientID;
      note right: isNew = false
    else (no)
      :Return ErrDuplicatedResource;
      detach
    endif
  else (no)
    :INSERT user;
    :INSERT client;
    :Return new clientID;
    note right: isNew = true
  endif
}

partition "Cart Association" {
  :SetCartClientID(tx, clientID, cartID);
  note right: UPDATE carts SET client_id
}

partition "Checkout Shop Association" #lightblue {
  :SetCheckoutShopClientID(tx, clientID, cartID);  ' NEW step
  note right
    UPDATE checkout_shop cs
    SET client_id = $1
    FROM checkouts chk
    WHERE chk.cart_id = $2
      AND cs.checkout_id = chk.id
  end note
}

partition "Commit" {
  :COMMIT transaction;
  note right: All-or-nothing:
  note right: cart and checkout_shop\nboth get client_id
}

if (isNew?) then (yes)
  :Send welcome email with\npassword + login link;
else (no)
  :Send confirmation email\n(no login details);
endif

stop
@enduml
