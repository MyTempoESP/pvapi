@startuml
' Component diagram: layered architecture for the pvapi-gmru feature
' Shows bounded contexts and interfaces involved in monitor data editing

skinparam componentStyle rectangle

actor "Shop" as Shop
actor "Admin" as Admin

package "HTTP Layer" as HttpLayer {
  [Auth Middleware\n(gin-jwt)] as AuthMW
  [Log Middleware] as LogMW
}

package "Controllers" as Controllers {
  [Consignee Handler\n(PUT /monitores/:id)] as Handler
  note right of Handler
    Parses JSON body,
    extracts shop from JWT,
    delegates to model
  end note
  Handler --> "Owns Check" : verifyProperty
  Handler --> "Transaction Manager" : BeginFunc
}

package "Authorization\n(Policy Gate)" as GatePkg {
  portin "Dispatch(PUT)" as gate_in
  () "Owns(shop, consignee)" as owns_iface
  component ConsigneeGate {
    portin "Modify()" as modify_in
    portout "Owns()" as owns_out
  }
  gate_in --> modify_in
  owns_out --> owns_iface
}

package "Models" as Models {
  component "consigneemodel" as CM {
    [Consignee.Update]
    [Consignee.FindByID]
  }
  component "shopmodel" as SM {
    [HasConsignee]
  }
  component "usermodel" as UM
  component "address" as AM
  SM --> owns_iface : implements
}

package "Query Builder" as QBuild {
  component "squirrel\n(Masterminds)" as Sq
  [Dynamic SET Builder]
  Sq --> [Dynamic SET Builder]
}

database "PostgreSQL" as DB {
  [users]
  [consignees]
  [addresses]
  [consignees_info_full_view]
}

' Connections

Shop --> AuthMW : HTTPS\n(JWT + JSON)
AuthMW --> LogMW
LogMW --> Handler : gin.Context\n(auth'd user)

Handler --> gate_in : gate.Dispatch()
owns_iface --> SM : HasConsignee()
SM --> DB : ShopHasConsigneeQuery

Handler --> CM : Save() / FindByID()
CM --> DB : SELECT / UPDATE
CM --> AM : address.Params()
CM --> UM : user updates

Handler --> QBuild : squirrel.Update().SetMap()
QBuild --> DB : generated SQL

Admin --> AuthMW : HTTPS

@enduml
