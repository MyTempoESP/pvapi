@startuml
' Component diagram: module boundaries and interfaces for pickup confirmation email
' Shows the refactored architecture with new types and interface changes

skinparam componentStyle rectangle

actor "Checkout Client" as Client

package "Controllers" {
  component "Checkout Controller" as CCtrl {
    portout "mail.Mailer" as ctrl_mail
    portout "checkoutmodel" as ctrl_cm
    portout "clientmodel" as ctrl_cl
  }
}

package "Mail Package (mail/)" {
  () "Mailer" as MailerIF

  component "Client" as MailClient {
    portin "SendPickupConfirmation" as mail_in
  }

  component "NoopMailer" as Noop
  component "SpyMailer" as Spy {
    [SentConfirmation\n*PickupEmailData]
  }

  [PickupEmailData] as PED
  [PickupGroup] as PG
  [PickupItem] as PI

  component "Template Engine" as Tpl {
    [pickup_confirmation.html\nconditional login block]
  }

  PED --> PG
  PG --> PI
}

package "Checkout Model (checkoutmodel/)" {
  component "Confirm" as CM
  component "ResolvePickupEmailData" as Resolver
}

package "Client Model (clientmodel/)" {
  component "Create" as Create {
    note right: returns (clientID, isNew, error)
  }
  component "CreateAndAssociate" as CAA
}

database "PostgreSQL" as DB {
  [packages]
  [products]
  [consignments]
  [pickup_locations]
  [users]
  [carts]
}

package "Environment" {
  [SMTP config\nlogin/reset URLs]
}

Client --> CCtrl : POST /checkouts/confirm

ctrl_mail --> MailerIF
MailerIF <|.. MailClient
MailerIF <|.. Noop
MailerIF <|.. Spy
MailClient --> Tpl : renders template
MailClient --> PED : receives
mail_in --> SMTP : sends email

ctrl_cm --> CM : confirm checkout
ctrl_cm --> Resolver : resolve order data
ctrl_cl --> CAA : create client + associate cart

Resolver --> DB : query packages→products→pickups
Create --> DB : insert/select users
CAA --> Create : wraps
CAA --> DB : update cart client_id

MailClient --> [SMTP config\nlogin/reset URLs] : reads
@enduml
