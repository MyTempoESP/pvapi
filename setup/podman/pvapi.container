[Unit]
Description=PVAUTO api
After=network-online.target

[Container]
Image=linhazero/pvapi:latest

Pod=pvauto.pod

Volume=%h/pvapi/data:/app/public:Z
Environment=PV_API_SECURE_COOKIE=yes
Environment=PV_API_SECRET="REDACTED_JWT_SECRET"
Environment=PV_API_DB_HOST=localhost
Environment=PV_API_DB_USER=pvauto
Environment=PV_API_DB_PASS="REDACTED_DB_PASS"
Environment=PV_API_DB_BASE=pvauto_db
Environment=PV_API_DB_PORT=5432
Environment=PV_API_ADMIN_USER=lzero
Environment=PV_API_ADMIN_MAIL=sistemas@linhazero.com
Environment=PV_API_ADMIN_PASS=REDACTED_ADMIN_PASS
Environment=PV_API_LOG_LEVEL=debug
Environment=PV_API_PRODUCTION=yes

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
